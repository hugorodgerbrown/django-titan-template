{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Dev server",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "SITE_URL=http://localhost:8010 exec uv run python manage.py runserver 127.0.0.1:8010"
      ],
      "port": 8010
    }{% if include_mcp %},
    {
      "name": "MCP Inspector",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "MCP_AUTO_OPEN_ENABLED=false exec npx -y @modelcontextprotocol/inspector"
      ],
      "port": 6274
    }{% endif %}
  ]
}
