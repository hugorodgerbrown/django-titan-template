[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = {{ description | tojson | replace("\\u0027", "'") | replace("\\u0026", "&") | replace("\\u003c", "<") | replace("\\u003e", ">") }}
authors = [{ name = {{ author_name | tojson | replace("\\u0027", "'") | replace("\\u0026", "&") | replace("\\u003c", "<") | replace("\\u003e", ">") }}, email = {{ author_email | tojson | replace("\\u0027", "'") | replace("\\u0026", "&") | replace("\\u003c", "<") | replace("\\u003e", ">") }} }]
requires-python = ">=3.14,<3.15"
dependencies = [
    "dj-database-url>=3.1.2,<4",
    "django>=6.1.1,<6.2",
    "gunicorn>=26.2.0,<27",
{%- if include_mcp %}
    "mcp-auth",
{%- endif %}
    "psycopg[binary]>=3.3.6,<4",
    "python-decouple>=3.8,<4",
    "webauthn>=3.0.0,<4",
    "whitenoise>=6.12.0,<7",
]

# One group per tox env, so each env installs only what it needs. `dev`
# composes them all for a local `uv sync`.
[dependency-groups]
test = [
    "factory-boy>=3.3.3,<4",
    "freezegun>=1.5.5,<2",
    "pytest>=9.1.1,<10",
    "pytest-cov>=7.1.0,<8",
    "pytest-django>=4.14.0,<5",
    "pytest-xdist>=3.8.0,<4",
]
lint = [
    # Exact pin, bumped in step with .pre-commit-config.yaml so the hook and
    # CI never disagree.
    "ruff==0.16.10",
]
types = [
    "django-stubs>=6.0.2,<7",
    "mypy>=2.3.0,<2.5",
    # mypy checks tests/ too (browser journeys included), so it needs their packages.
    {include-group = "e2e"},
]
e2e = [
    "playwright>=1.62.0,<1.64",
    "pytest-playwright>=0.7,<0.10",
    {include-group = "test"},
]
dev = [
    "pre-commit>=4.6.1,<5",
    "tox>=4.52.1,<5",
    "tox-uv>=1.0,<2",
    {include-group = "test"},
    {include-group = "lint"},
    {include-group = "types"},
    {include-group = "e2e"},
]

[tool.uv]
package = false
default-groups = ["dev"]
{%- if include_mcp %}

[tool.uv.sources]
# The shared Titan MCP auth app, pinned to a release tag.
mcp-auth = { git = "https://github.com/hugorodgerbrown/mcp-auth", tag = "{{ mcp_auth_version }}" }
{%- endif %}

[tool.pytest.ini_options]
DJANGO_SETTINGS_MODULE = "config.settings"
pythonpath = ["."]
testpaths = ["tests"]
addopts = "--ignore=tests/e2e --ignore=tests/js"
filterwarnings = ["ignore:No directory at:UserWarning"]

[tool.ruff]
target-version = "py314"
line-length = 100
extend-exclude = ["*/migrations/*"]

[tool.ruff.lint]
select = [
    "E", "F", "I", "B", "UP", "DJ",
    "S",    # flake8-bandit: security
    "SIM",  # simplifications
    "C4",   # comprehensions
    "PT",   # pytest style
    "PIE",
    "RET",
    "RUF",
    "T20",  # stray print()
    "DTZ",  # naive datetimes
    "D",    # a docstring on every module, class and function
]
ignore = [
    "RUF012",  # Django's Meta and admin options are mutable class attributes by design.
    "D105", "D107",  # dunder methods and __init__ are documented by their class
]

[tool.ruff.lint.pydocstyle]
convention = "google"

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["S101", "S105", "S106"]
"**/migrations/*" = ["D"]
# The template writes its free-form answers (name, description) here verbatim.
"apps/pwa/conf.py" = ["E501"]

[tool.mypy]
python_version = "3.14"
plugins = ["mypy_django_plugin.main"]
strict_optional = true
warn_return_any = true
warn_unused_configs = true
warn_redundant_casts = true
warn_unused_ignores = true
warn_unreachable = true
disallow_untyped_defs = true
disallow_incomplete_defs = true
exclude = ["/migrations/", "^\\.venv/", "^node_modules/"]

[[tool.mypy.overrides]]
module = ["decouple", "factory", "factory.*", "oauth2_provider.*"]
ignore_missing_imports = true

[tool.django-stubs]
django_settings_module = "config.settings"

[tool.coverage.run]
source = ["apps", "config"]
omit = ["*/migrations/*", "config/asgi.py", "config/wsgi.py"]

[tool.coverage.report]
fail_under = 90
skip_empty = true
show_missing = true
exclude_also = ["if TYPE_CHECKING:"]
