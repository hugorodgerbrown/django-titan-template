# Copy to .env for local overrides; every value has a safe local default.
DJANGO_DEBUG=1
# DJANGO_SECRET_KEY=   # required when DJANGO_DEBUG=0
# ACCOUNTS_EMAIL_KEY=  # required when DJANGO_DEBUG=0; keys email addresses, never change it
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# SITE_URL=http://localhost:8000          # links in emails; the passkey origin
# Email: printed to the console unless DJANGO_DEBUG=0 or EMAIL_BACKEND is set.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL="My Project <hello@example.com>"
# Visitor counts by fivebar (https://fiveb.ar): off unless set, to the
# site's domain as added to fivebar. Nothing is counted from localhost.
# FIVEBAR_DOMAIN=example.ultraniche.ai
