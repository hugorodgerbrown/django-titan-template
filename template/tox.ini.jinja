# Every check CI runs. `uv run tox` runs the default list; `uv run tox -e <env>`
# runs one. CI runs each env as its own job (.github/workflows/ci.yml), so a
# green local run means a green PR.
[tox]
no_package = True
envlist = fmt, lint, types, checks, test, js, audit

# tox scrubs the environment; behind a TLS-inspecting proxy the tools need
# these to reach PyPI, npm and the semgrep registry. Each is a no-op unset.
[testenv]
base_python = py314
passenv =
    SSL_CERT_FILE
    REQUESTS_CA_BUNDLE
    NODE_EXTRA_CA_CERTS
    *_PROXY
    *_proxy
    PLAYWRIGHT_BROWSERS_PATH
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD
    PLAYWRIGHT_CHROMIUM_EXECUTABLE
runner = uv-venv-lock-runner
# Fail on a stale uv.lock instead of quietly re-resolving.
uv_sync_flags = --frozen

[testenv:fmt]
description = Formatting (ruff format)
dependency_groups = lint
commands = ruff format --check .

[testenv:lint]
description = Linting, import order, docstrings and bandit security rules (ruff)
dependency_groups = lint
commands = ruff check .

[testenv:types]
description = Type checking (mypy + django-stubs)
dependency_groups = types
commands = mypy .

[testenv:checks]
description = Django deploy checks with production settings, and missing migrations
dependency_groups = test
setenv =
    DJANGO_DEBUG = 0
    DJANGO_SECRET_KEY = tox-checks-only-0123456789-abcdefghijklmnopqrstuvwxyz-ABCDEFGHIJ
commands =
    python manage.py check --deploy --fail-level WARNING
    python manage.py makemigrations --check --dry-run

[testenv:test]
description = Python tests with coverage (fails under the floor in pyproject.toml)
dependency_groups = test
commands = pytest -n auto --cov --cov-report=term-missing:skip-covered {posargs}

[testenv:js]
description = JavaScript unit tests (Vitest, jsdom, fake-indexeddb)
runner = virtualenv
skip_install = True
allowlist_externals = npm, npx
commands =
    npm ci --no-audit --no-fund --silent
    npx vitest run {posargs}

# Real browser, real service worker. Small on purpose: see docs/testing.md.
[testenv:e2e]
description = Browser journeys (Playwright): install, offline reload, queued write
dependency_groups = e2e
setenv =
    DJANGO_ALLOW_ASYNC_UNSAFE = true
commands = pytest tests/e2e -p no:xdist --override-ini addopts= {posargs}

[testenv:audit]
description = Known CVEs in the production dependencies (pip-audit) and npm packages
runner = virtualenv
skip_install = True
deps = pip-audit
allowlist_externals = uv, npm
commands =
{%- if include_mcp %}
    # mcp-auth is a git dependency pip-audit can't look up; its own
    # dependencies are still exported and audited.
    uv export --frozen --no-dev --no-emit-project --no-emit-package mcp-auth --format requirements-txt --quiet --output-file {envtmpdir}/requirements.txt
{%- else %}
    uv export --frozen --no-dev --no-emit-project --format requirements-txt --quiet --output-file {envtmpdir}/requirements.txt
{%- endif %}
    pip-audit --disable-pip --requirement {envtmpdir}/requirements.txt
    npm audit --audit-level=high

# Not in the default list: it downloads rule packs from semgrep.dev on every
# run. CI runs it on every push and weekly.
[testenv:sast]
description = Static security analysis (semgrep: Django, Python, JavaScript and security-audit packs)
runner = virtualenv
skip_install = True
deps = semgrep
setenv =
    SEMGREP_SEND_METRICS = off
    XDG_CONFIG_HOME = {envtmpdir}
    XDG_CACHE_HOME = {envtmpdir}
commands =
    semgrep scan --config=p/django --config=p/python --config=p/javascript \
        --config=p/security-audit \
        --exclude=.venv --exclude=.tox --exclude=node_modules --exclude=migrations \
        --exclude=static/vendor \
        --error --metrics=off .
