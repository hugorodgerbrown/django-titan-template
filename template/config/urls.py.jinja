"""Root URL configuration."""

from django.contrib import admin
from django.contrib.auth import views as auth_views
from django.urls import include, path

from apps.core.views import healthz, home
{%- if include_mcp %}
from apps.mcp.views import mcp
{%- endif %}

admin.site.site_header = "{{ project_name }}"
admin.site.site_title = "{{ project_name }}"

urlpatterns = [
    path("", home, name="home"),
    path("healthz", healthz, name="healthz"),
    path("admin/", admin.site.urls),
    path(
        "login/",
        auth_views.LoginView.as_view(redirect_authenticated_user=True),
        name="login",
    ),
    path("logout/", auth_views.LogoutView.as_view(), name="logout"),
    path("", include("apps.pwa.urls")),
    path("notes/", include("apps.notes.urls")),
{%- if include_mcp %}
    path("", include("mcp_auth.urls")),
    path("mcp", mcp, name="mcp"),
{%- endif %}
]
